# Supabase project settings > API. Use the publishable/anon key, NEVER service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Configure Supabase SMTP, URL allowlist and email confirmation in the dashboard.

# Optional server-only messaging. Do not prefix any secret with NEXT_PUBLIC_.
# Service role is ONLY for verified delivery webhooks. Never use it for browser auth.
SUPABASE_SERVICE_ROLE_KEY=
MESSAGING_ENABLED=false
# Set true only after public webhook + unsubscribe URLs have been tested.
PUBLIC_CALLBACKS_READY=false
PUBLIC_APP_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PROGRESS_TEMPLATE=
WHATSAPP_PROGRESS_LANGUAGE=en
